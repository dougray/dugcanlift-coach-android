<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light by default, values-night for dark. The window background is drawn
         before Compose can read the appearance setting, so it follows the phone.
         Must equal DclPalette.BG_LIGHT / BG; XML can't reference the Kotlin
         constants, so update these by hand if the palette moves. -->
    <style name="Theme.Coach" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#F4EFE7</item>
    </style>
</resources>
