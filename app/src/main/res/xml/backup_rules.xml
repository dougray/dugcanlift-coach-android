<?xml version="1.0" encoding="utf-8"?>
<!--
   Belt and braces. allowBackup="false" in the manifest already stops Auto
   Backup, but this file is what the tooling reads on API 30 and below, and an
   empty one here reads as "no opinion" rather than "no". Excluding the root
   says it outright.

   Imported client data is meant to stay on the device, not ride Auto Backup
   off it.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
</full-backup-content>
