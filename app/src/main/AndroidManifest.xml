<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The one request Coach makes: a street-map download the coach starts, from the kit's
         MapDownload (https to the one tile host, nothing else). No app source opens a
         connection (NoAppConnection pins it). MapLibre merges in the two network-state
         permissions, which nothing here needs: removed. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" tools:node="remove" />
    <!-- MapLibre's own manifest also asks for location, for a location dot Coach never draws. Coach
         never asks where the coach is. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />

    <!-- allowBackup is off deliberately, matching every app in this family:
         imported client data is meant to stay on the device, not ride Auto
         Backup to the coach's Google Drive. -->
    <application
        android:name=".CoachApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Coach">
        <!-- Resizeable and unlocked in orientation: tablets, foldables and split screen get
             adaptive layouts by window width (ui/adaptive/WindowLayout.kt). Size, orientation
             and fold changes are handled in place rather than by recreating the activity: the
             whole UI is Compose and re-lays itself out, and nothing typed into an open dialog is
             lost when a foldable opens. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:resizeableActivity="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Coach">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Tap-to-import: a lifter's shared link opens Coach and imports instead of a web
                 page. autoVerify requires assetlinks.json to be live on the site (see the
                 dugcanlift-site .well-known/assetlinks.json branch); until then Android falls
                 back to the disambiguation sheet instead of auto-opening Coach. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="www.dugcanlift.com"
                    android:pathPrefix="/coach/" />
            </intent-filter>

            <!-- "Send to Coach": the recipe bookmarklet opens dugcanliftcoach://recipe#r1...,
                 the scheme Coach iPhone owns, so one bookmark works on either phone. The page's
                 recipe rides after the # and nothing is fetched (dugcanlift-kit
                 bookmarklet/README.md). A custom scheme needs no site file and no permission. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="dugcanliftcoach"
                    android:host="recipe" />
            </intent-filter>

            <!-- Share-sheet target: a coach can also share the link text directly into Coach. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>

</manifest>
